{
  "functions": {
    "api/ai.js": {
      "maxDuration": 300
    },
    "api/auth.js": {
      "maxDuration": 30
    },
    "api/sync.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
